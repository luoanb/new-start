{
  "name": "@pulsar/plugin-host",
  "version": "0.1.0",
  "private": true,
  "description": "插件宿主平台：Cordis 运行时 + 插件装卸 + HTTP 扩展点，不含任何业务代码",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "verify": "tsx src/verify.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/cordis-plugin-logger-console": "workspace:*",
    "@deepseek-ai/cordis-plugin-timer": "workspace:*",
    "@pulsar/plugin-client": "workspace:*",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
