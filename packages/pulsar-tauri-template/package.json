{
  "name": "pulsar-tauri-template",
  "version": "0.1.0",
  "description": "pulsar-tauri-template — 只含与功能无关的 Tauri 应用基建骨架",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "tauri:dev": "node scripts/dev-tauri.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "fresh-user": "node scripts/fresh-user.mjs",
    "release": "node scripts/release.mjs",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^6.0.3"
  }
}
