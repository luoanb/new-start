{
  "name": "pulsar-app",
  "version": "0.2.1",
  "description": "Pulsar（星脉）— 自主推进的 AI Agent 桌面客户端",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "tauri:dev": "PULSAR_PORT=8899 tauri dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cli": "cargo run --manifest-path src-tauri/Cargo.toml --bin pulsar-cli --",
    "tui": "cargo run --manifest-path src-tauri/Cargo.toml --bin pulsar-tui",
    "fresh-user": "node scripts/fresh-user.mjs",
    "tauri": "tauri",
    "server:build": "pnpm build && cargo build --release --manifest-path src-tauri/Cargo.toml --bin pulsar-server --features embed-static",
    "server:prod": "PULSAR_HOST=0.0.0.0 PULSAR_PORT=9999 cargo run --release --manifest-path src-tauri/Cargo.toml --bin pulsar-server --features embed-static --",
    "server:run": "cargo run --release --manifest-path src-tauri/Cargo.toml --bin pulsar-server --features embed-static --",
    "server:dev": "pnpm build && PULSAR_HOST=127.0.0.1 PULSAR_PORT=8899 cargo run --manifest-path src-tauri/Cargo.toml --bin pulsar-server --features embed-static --"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/svelte": "^1.6.2",
    "codemirror": "^6.0.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
