{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulsar",
  "version": "0.2.4",
  "identifier": "com.pulsar.app",
  "mainBinaryName": "pulsar-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1432",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "星脉",
        "width": 800,
        "height": 600,
        "devtools": true,
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
