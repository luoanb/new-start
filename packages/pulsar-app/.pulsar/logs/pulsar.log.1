initial-scale=1.0, maximum-scale=1.0, user-scalable=no\\\">\\n<title>魂斗罗 - Contra</title>\\n<style>\\n  html,body{margin:0;padding:0;height:100%;overflow:hidden;background:#05050a;\\n    display:flex;align-items:center;justify-content:center;font-family:sans-serif;}\\n  #wrap{position:relative;display:inline-block;line-height:0;}\\n  canvas{background:#000;image-rendering:pixelated;image-rendering:crisp-edges;\\n    display:block;width:min(96vw, calc(96vh * 4 / 3));height:auto;aspect-ratio:4/3;\\n    border:2px solid #2a2a3a;box-shadow:0 0 40px #000, 0 0 12px #334;}\\n  #touch{position:absolute;left:0;top:0;width:100%;height:100%;display:none;pointer-events:none;z-index:5;}\\n  #touch .btn{pointer-events:auto;position:absolute;background:rgba(255,255,255,.14);border:2px solid rgba(255,255,255,.35);\\n    color:#fff;font-size:26px;font-weight:bold;border-radius:14px;display:flex;align-items:center;justify-content:center;\\n    user-select:none;-webkit-user-select:none;touch-action:none;}\\n  #touch .btn:active{background:rgba(255,255,255,.42);}\\n  .t-left{left:3%;bottom:5%;width:15%;height:22%;}\\n  .t-right{left:20%;bottom:5%;width:15%;height:22%;}\\n  .t-jump{right:20%;bottom:5%;width:16%;height:24%;border-radius:50%;}\\n  .t-shoot{right:3%;bottom:5%;width:16%;height:24%;border-radius:50%;}\\n  @media (pointer:coarse){ #touch{display:block;} }\\n</style>\\n</head>\\n<body>\\n<div id=\\\"wrap\\\">\\n  <canvas id=\\\"game\\\" width=\\\"320\\\" height=\\\"240\\\"></canvas>\\n  <div id=\\\"touch\\\">\\n    <div class=\\\"btn t-left\\\" id=\\\"t-left\\\">◀</div>\\n    <div class=\\\"btn t-right\\\" id=\\\"t-right\\\">▶</div>\\n    <div class=\\\"btn t-jump\\\" id=\\\"t-jump\\\">跳</div>\\n    <div class=\\\"btn t-shoot\\\" id=\\\"t-shoot\\\">射</div>\\n  </div>\\n</div>\\n<script>\\n'use strict';\\n/* ================= 魂斗罗 (Contra-style run & gun) =================\\n   操作：←→/AD 移动   ↑/W 瞄准上   ↓/S 下蹲   Z/J/空格 射击   X/K 跳跃\\n         P/Esc 暂停   M 静音   Enter 开始/继续\\n==================================================================== */\\n\\n/* ---------- 基础 ---------- */\\nconst canvas = document.getElementById('game');\\nconst ctx = canvas.getContext('2d');\\nconst VW = 320, VH = 240, TILE = 16, MAP_H = 15;\\nconst T_EMPTY = 0, T_SOLID = 1, T_PLAT = 2, T_SPIKE = 3, T_BRICK = 4, T_WATER = 5;\\n\\nconst clamp = (v, a, b) => v < a ? a : (v > b ? b : v);\\nconst range = (a, b) => { const r = []; for (let i = a; i <= b; i++) r.push(i); return r; };\\nfunction setRange(arr, a, b, v) { for (let i = a; i <= b; i++) arr[i] = v; }\\nfunction rectsOverlap(a, b) {\\n  return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;\\n}\\n\\n/* ---------- 音频 ---------- */\\nlet actx = null, muted = false;\\nfunction ensureAudio() {\\n  if (!actx) { try { actx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {} }\\n  if (actx && actx.state === 'suspended') actx.resume();\\n}\\nfunction tone(freq, dur, type, vol, slide, delay) {\\n  if (!actx || muted) return;\\n  type = type || 'square'; vol = vol || 0.12; delay = delay || 0;\\n  const t0 = actx.currentTime + delay;\\n  const o = actx.createOscillator(), g = actx.createGain();\\n  o.type = type; o.frequency.setValueAtTime(freq, t0);\\n  if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(30, freq + slide), t0 + dur);\\n  g.gain.setValueAtTime(vol, t0);\\n  g.gain.exponentialRampToValueAtTime(0.001, t0 + dur);\\n  o.connect(g); g.connect(actx.destination);\\n  o.start(t0); o.stop(t0 + dur + 0.05);\\n}\\nfunction noise(dur, vol, delay) {\\n  if (!actx || muted) return;\\n  vol = vol || 0.18; delay = delay || 0;\\n  const t0 = actx.currentTime + delay;\\n  const len = Math.floor(actx.sampleRate * dur);\\n  const buf = actx.createBuffer(1, len, actx.sampleRate);\\n  const d = buf.getChannelData(0);\\n  for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / len);\\n  const src = actx.createBufferSource(); src.buffer = buf;\\n  const f = actx.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = 900;\\n  const g = actx.createGain(); g.gain.setValueAtTime(vol, t0);\\n  g.gain.exponentialRampToValueAtTime(0.001, t0 + dur);\\n  src.connect(f); f.connect(g); g.connect(actx.destination);\\n  src.start(t0);\\n}\\nfunction sfx(name) {\\n  switch (name) {\\n    case 'shoot':  tone(760, 0.07, 'square', 0.07, -420); break;\\n    case 'eshoot': tone(420, 0.10, 'sawtooth', 0.06, -200); break;\\n    case 'hit':    tone(220, 0.05, 'square', 0.06, -80); break;\\n    case 'jump':   tone(300, 0.11, 'square', 0.06, 320); break;\\n    case 'die':    noise(0.5, 0.3); tone(140, 0.5, 'sawtooth', 0.16, -80); break;\\n    case 'expl':   noise(0.35, 0.3); tone(120, 0.3, 'sawtooth', 0.14, -60); break;\\n    case 'big':    noise(0.8, 0.4); tone(60, 0.8, 'sawtooth', 0.2, -30); break;\\n    case 'hurt':   tone(240, 0.16, 'sawtooth', 0.14, -120); noise(0.12, 0.12); break;\\n    case 'power':  tone(523, 0.08, 'square', 0.1); tone(659, 0.08, 'square', 0.1, 0, 0.07); tone(784, 0.12, 'square', 0.1, 0, 0.14); break;\\n    case 'pickup': tone(880, 0.06, 'square', 0.09, 200); break;\\n    case 'alarm':  tone(660, 0.12, 'square', 0.1); tone(660, 0.12, 'square', 0.1, 0, 0.14); tone(660, 0.12, 'square', 0.1, 0, 0.28); break;\\n    case 'charge': tone(200, 0.3, 'sawtooth', 0.12, 300); break;\\n    case 'clear':  tone(523, 0.12, 'square', 0.1); tone(659, 0.12, 'square', 0.1, 0, 0.12); tone(784, 0.12, 'square', 0.1, 0, 0.24); tone(1046, 0.3, 'square', 0.12, 0, 0.36); break;\\n    case 'gameover': tone(392, 0.2, 'sawtooth', 0.12); tone(330, 0.2, 'sawtooth', 0.12, 0, 0.2); tone(262, 0.5, 'sawtooth', 0.14, 0, 0.4); break;\\n  }\\n}\\n\\n/* ---------- 输入 ---------- */\\nconst hold = { left:false, right:false, up:false, down:false, shoot:false, jump:false };\\nconst just = new Set();\\nlet startPressed = false, pausePressed = false, mutePressed = false;\\nlet shootHeld = false, jumpHeld = false;\\nfunction setKey(flag, val) {\\n  if (val && !hold[flag]) just.add(flag);\\n  hold[flag] = val;\\n}\\nconst KEYMAP = {\\n  arrowleft:'left', a:'left', arrowright:'right', d:'right',\\n  arrowup:'up', w:'up', arrowdown:'down', s:'down',\\n  z:'shoot', j:'shoot', ' ':'shoot',\\n  x:'jump', k:'jump', enter:'start', p:'pause', escape:'pause', m:'mute'\\n};\\nwindow.addEventListener('keydown', e => {\\n  ensureAudio();\\n  const f = KEYMAP[e.key.toLowerCase()];\\n  if (f) { setKey(f, true); e.preventDefault(); }\\n});\\nwindow.addEventListener('keyup', e => {\\n  const f = KEYMAP[e.key.toLowerCase()];\\n  if (f) setKey(f, false);\\n});\\nfunction bindTouch(id, flag) {\\n  const el = document.getElementById(id);\\n  const dn = e => { e.preventDefault(); ensureAudio(); setKey(flag, true); };\\n  const up = e => { e.preventDefault(); setKey(flag, false); };\\n  el.addEventListener('pointerdown', dn);\\n  el.addEventListener('pointerup', up);\\n  el.addEventListener('pointerleave', up);\\n  el.addEventListener('pointercancel', up);\\n}\\nbindTouch('t-left','left'); bindTouch('t-right','right');\\nbindTouch('t-jump','jump'); bindTouch('t-shoot','shoot');\\n\\n/* ---------- 全局状态 ---------- */\\nlet state = 'title';      // title | intro | playing | stageClear | gameover | victory\\nlet paused = false;\\nlet stage = 0, W = 0, map = null;\\nlet camX = 0, camY = 0, shake = 0, time = 0;\\nlet score = 0;\\nlet hiScore = 0;\\ntry { hiScore = +(localStorage.getItem('contra_hi') || 0); } catch (e) {}\\nlet lives = 3;\\nlet player = null, enemies = [], pBullets = [], eBullets = [], items = [], pickups = [], parts = [];\\nlet boss = null, bossLocked = false, bossCleared = false, ended = false;\\nlet respawn = null, brickHp = null;\\nlet stateTimer = 0, introText = '';\\n\\n/* ================= 关卡定义 ================= */\\nconst STAGES = [\\n  { name:'STAGE 1', sub:'丛林地带', W:320, theme:'jungle', bossType:'core', bossHP:80, bossXTile:305,\\n    ground:null, platforms:[], spikes:[], items:[], enemies:[], checkpoints:[70,160,240] },\\n  { name:'STAGE 2', sub:'外星要塞', W:300, theme:'fort', bossType:'mother', bossHP:100, bossXTile:290,\\n    ground:null, platforms:[], spikes:[], items:[], enemies:[], checkpoints:[80,160,240] }\\n];\\n\\n(function buildStageDefs() {\\n  // ---- Stage 1 丛林 ----\\n  const s1 = STAGES[0];\\n  const g1 = new Array(s1.W).fill(13);\\n  setRange(g1, 42, 44, -1); setRange(g1, 96, 99, -1);\\n  setRange(g1, 152, 155, -1); setRange(g1, 214, 217, -1); setRange(g1, 268, 271, -1);\\n  setRange(g1, 62, 66, 11); setRange(g1, 70, 74, 9);\\n  setRange(g1, 158, 168, 11); setRange(g1, 196, 200, 9); setRange(g1, 240, 246, 11);\\n  s1.ground = g1;\\n  s1.platforms = [\\n    {x:20,w:6,y:9}, {x:44,w:8,y:11}, {x:62,w:4,y:7}, {x:98,w:8,y:11},\\n    {x:120,w:6,y:8}, {x:150,w:6,y:10}, {x:170,w:6,y:8}, {x:180,w:6,y:9},\\n    {x:216,w:8,y:11}, {x:232,w:5,y:8}, {x:270,w:8,y:11}\\n  ];\\n  s1.spikes = [ {x:90,w:3,y:12}, {x:190,w:3,y:12}, {x:250,w:3,y:12} ];\\n  s1.items = [\\n    {x:30, y:6, letter:'M'}, {x:105, y:6, letter:'H'},\\n    {x:135, y:6, letter:'S'}, {x:245, y:6, letter:'R'}\\n  ];\\n  s1.enemies = [\\n    ['runner',25],['runner',55],['shooter',35],['runner',75],['flier',90,4],\\n    ['runner',115],['shooter',100],['runner',135],['elite',150],['runner',175],\\n    ['turret',125],['flier',140,5],['shooter',160],['runner',205],['flier',205,4],\\n    ['turret',185],['shooter',210],['runner',225],['elite',235],['turret',245],\\n    ['runner',255],['flier',260,5],['shooter',250],['runner',280]\\n  ];\\n  // ---- Stage 2 要塞 ----\\n  const s2 = STAGES[1];\\n  const g2 = new Array(s2.W).fill(13);\\n  setRange(g2, 52, 54, -1); setRange(g2, 104, 107, -1); setRange(g2, 156, 159, -1);\\n  setRange(g2, 208, 211, -1); setRange(g2, 258, 260, -1);\\n  setRange(g2, 64, 70, 11); setRange(g2, 96, 100, 9); setRange(g2, 160, 172, 10); setRange(g2, 220, 230, 9);\\n  s2.ground = g2;\\n  s2.platforms = [\\n    {x:30,w:6,y:9}, {x:55,w:8,y:11}, {x:80,w:6,y:7}, {x:104,w:8,y:11},\\n    {x:125,w:6,y:9}, {x:156,w:8,y:11}, {x:185,w:6,y:8}, {x:205,w:6,y:10},\\n    {x:222,w:6,y:7}, {x:240,w:6,y:9}, {x:262,w:8,y:11}\\n  ];\\n  s2.spikes = [ {x:90,w:3,y:12}, {x:180,w:3,y:12}, {x:240,w:3,y:12} ];\\n  s2.items = [\\n    {x:60, y:6, letter:'S'}, {x:100, y:6, letter:'H'}, {x:150, y:6, letter:'R'},\\n    {x:210, y:6, letter:'M'}, {x:240, y:6, letter:'H'}\\n  ];\\n  s2.enemies = [\\n    ['runner',30],['shooter',60],['runner',70],['flier',80,3],['turret',90],\\n    ['runner',120],['shooter',140],['flier',130,4],['elite',110],['runner',150],\\n    ['turret',170],['shooter',200],['flier',190,4],['elite',210],['runner',180],\\n    ['turret',235],['runner',230],['flier',245,5],['shooter',250],['runner',270]\\n  ];\\n})();\\n\\nfunction buildMap(def) {\\n  const m = [];\\n  for (let x = 0; x < def.W; x++) m[x] = new Array(MAP_H).fill(T_EMPTY);\\n  for (let x = 0; x < def.W; x++) {\\n    const g = def.ground[x];\\n    if (g >= 0) for (let r = g; r < MAP_H; r++) m[x][r] = T_SOLID;\\n    else { m[x][13] = T_WATER; m[x][14] = T_WATER; } // 坑底是水/岩浆\\n  }\\n  for (const p of def.platforms) for (let x = p.x; x < p.x + p.w; x++) if (m[x][p.y] === T_EMPTY) m[x][p.y] = T_PLAT;\\n  for (const s of def.spikes) for (let x = s.x; x < s.x + s.w; x++) m[x][s.y] = T_SPIKE;\\n  m[def.W - 1] = new Array(MAP_H).fill(T_SOLID); // 右边界墙\\n  return m;\\n}\\nfunction tileAt(x, y) {\\n  if (x < 0 || x >= W || y < 0 || y >= MAP_H) return 0;\\n  return map[x][y];\\n}\\nfunction isSolid(x, y) {\\n  const t = tileAt(x, y);\\n  return t === T_SOLID || t === T_BRICK || t === T_SPIKE;\\n}\\nfunction brickKey(x, y) { return x + ',' + y; }\\n\\n/* ---------- 地图碰撞移动 ---------- */\\nfunction moveEntity(e, oneWay) {\\n  if (oneWay === undefined) oneWay = true;\\n  e.onGround = false;\\n  // 水平\\n  e.x += e.vx;\\n  if (e.vx !== 0) {\\n    const dir = e.vx > 0 ? 1 : -1;\\n    const ex = dir > 0 ? e.x + e.w - 0.01 : e.x + 0.01;\\n    const cx = Math.floor(ex / TILE);\\n    const y0 = Math.floor(e.y / TILE), y1 = Math.floor((e.y + e.h - 0.01) / TILE);\\n    for (let cy = y0; cy <= y1; cy++) {\\n      if (isSolid(cx, cy)) {\\n        e.x = dir > 0 ? cx * TILE - e.w - 0.02 : (cx + 1) * TILE + 0.02;\\n        e.vx = 0; break;\\n      }\\n    }\\n  }\\n  // 垂直\\n  const prevBottom = e.y + e.h;\\n  e.y += e.vy;\\n  if (e.vy !== 0) {\\n    const dir = e.vy > 0 ? 1 : -1;\\n    const ey = dir > 0 ? e.y + e.h - 0.01 : e.y + 0.01;\\n    const cy = Math.floor(ey / TILE);\\n    const x0 = Math.floor(e.x / TILE), x1 = Math.floor((e.x + e.w - 0.01) / TILE);\\n    for (let cx = x0; cx <= x1; cx++) {\\n      const t = tileAt(cx, cy);\\n      if (t === T_SOLID || t === T_BRICK || t === T_SPIKE ||\\n          (oneWay && t === T_PLAT && dir > 0 && prevBottom <= cy * TILE + 0.5)) {\\n        if (dir > 0) { e.y = cy * TILE - e.h; e.onGround = true; }\\n        else e.y = (cy + 1) * TILE;\\n        e.vy = 0; break;\\n      }\\n    }\\n  }\\n}\\n\\n/* ---------- 粒子 ---------- */\\nfunction addPart(x, y, color, n, spd, life) {\\n  for (let i = 0; i < n; i++) {\\n    const a = Math.random() * Math.PI * 2, s = Math.random() * spd;\\n    parts.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s - spd * 0.3,\\n      life: life + Math.random() * life * 0.6, ttl: life + Math.random() * life * 0.6, color, size: Math.random() * 2 + 1 });\\n  }\\n}\\nfunction explosion(x, y, big) {\\n  addPart(x, y, '#ffd23f', big ? 26 : 10, big ? 3.4 : 2.4, big ? 45 : 26);\\n  addPart(x, y, '#ff6a00', big ? 16 : 6, big ? 2.6 : 1.8, big ? 30 : 16);\\n  addPart(x, y, '#888', big ? 12 : 5, big ? 2.0 : 1.4, big ? 34 : 20);\\n  shake = Math.max(shake, big ? 10 : 4);\\n  sfx('expl');\\n}\\nfunction updateParticles() {\\n  for (let i = parts.length - 1; i >= 0; i--) {\\n    const p = parts[i];\\n    p.x += p.vx; p.y += p.vy; p.vy += 0.12; p.life--;\\n    if (p.life <= 0) parts.splice(i, 1);\\n  }\\n}\\n\\n/* ================= 玩家 ================= */\\nfunction makePlayer(x, y) {\\n  return { x, y, w: 14, h: 20, vx: 0, vy: 0, onGround: false, facing: 1,\\n    crouch: false, hp: 100, maxHp: 100, invuln: 0, fireCd: 0,\\n    weapon: 'rifle', weaponTime: 0, anim: 0, dead: false, deadTimer: 0, coyote: 0, jbuf: 0 };\\n}\\nconst FIRE_CD = { rifle: 15, m: 6, s: 13, r: 4 };\\nconst BULLET_SPD = { rifle: 4.2, m: 5.0, s: 4.2, r: 5.5 };\\n\\nfunction updatePlayer() {\\n  const p = player;\\n  if (!p) return;\\n  if (p.dead) { p.deadTimer--; if (p.deadTimer <= 0) doRespawn(); return; }\\n  if (p.invuln > 0) p.invuln--;\\n  if (p.fireCd > 0) p.fireCd--;\\n  if (p.weaponTime > 0) { p.weaponTime--; if (p.weaponTime <= 0 && p.weapon !== 'rifle') p.weapon = 'rifle'; }\\n\\n  const sp = 1.7;\\n  p.vx = 0;\\n  if (hold.left) { p.vx = -sp; p.facing = -1; }\\n  if (hold.right) { p.vx = sp; p.facing = 1; }\\n  p.crouch = false;\\n  if (hold.down && p.onGround) { p.crouch = true; p.vx = 0; }\\n\\n  // 跳跃（含土狼时间与输入缓冲）\\n  p.coyote = p.onGround ? 6 : Math.max(0, p.coyote - 1);\\n  if (jumpHeld && !hold.jump === false && just.has('jump')) { p.jbuf = 8; }\\n  if (p.jbuf > 0) p.jbuf--;\\n  if (p.jbuf > 0 && p.coyote > 0) { p.vy = -5.7; p.onGround = false; p.jbuf = 0; p.coyote = 0; sfx('jump'); }\\n\\n  p.vy = Math.min(p.vy + 0.32, 8.5);\\n\\n  const newH = p.crouch ? 12 : 20;\\n  if (newH !== p.h) { p.y += p.h - newH; p.h = newH; }\\n\\n  moveEntity(p);\\n\\n  // 射击\\n  if (shootHeld && p.fireCd <= 0) {\\n    firePlayer(p);\\n    p.fireCd = FIRE_CD[p.weapon] || 15;\\n  }\\n  // 危险\\n  const cx = p.x + p.w / 2;\\n  const ct = tileAt(Math.floor(cx / TILE), Math.floor((p.y + p.h - 2) / TILE));\\n  if (ct === T_WATER || p.y > MAP_H * TILE + 16) { killPlayer(); return; }\\n  if (tileAt(Math.floor(cx / TILE), Math.floor((p.y + 4) / TILE)) === T_SPIKE ||\\n      tileAt(Math.floor(cx / TILE), Math.floor((p.y + p.h - 4) / TILE)) === T_SPIKE) { killPlayer(); return; }\\n}\\n\\nfunction firePlayer(p) {\\n  let dx = 0, dy = 0;\\n  if (hold.up) { dy = -1; dx = hold.left ? -1 : (hold.right ? 1 : 0); }\\n  else if (hold.down && !p.crouch) { dy = 1; dx = hold.left ? -1 : (hold.right ? 1 : 0); }\\n  else { dx = p.facing; dy = 0; }\\n  if (dx === 0 && dy === 0) dx = p.facing;\\n  const len = Math.hypot(dx, dy);\\n  const sp = BULLET_SPD[p.weapon] || 4.2;\\n  const gx = p.x + p.w / 2 + Math.sign(dx || p.facing) * 8;\\n  const gy = p.y + (p.crouch ? 4 : 8) + dy * 5;\\n  const base = Math.atan2(dy, dx);\\n  if (p.weapon === 's') {\\n    for (const off of [-0.28, 0, 0.28]) {\\n      pBullets.push({ x: gx - 2, y: gy - 2, vx: Math.cos(base + off) * sp, vy: Math.sin(base + off) * sp,\\n        w: 4, h: 4, dmg: 1, life: 80, from: 'p', color: '#ffe14d' });\\n    }\\n  } else {\\n    pBullets.push({ x: gx - 2, y: gy - 2, vx: dx / len * sp, vy: dy / len * sp,\\n      w: 4, h: 4, dmg: 1, life: 80, from: 'p', color: '#ffe14d' });\\n  }\\n  sfx('shoot');\\n}\\n\\nfunction damagePlayer(d) {\\n  if (!player || player.dead || player.invuln > 0) return;\\n  player.hp -= d;\\n  player.invuln = 55;\\n  sfx('hurt');\\n  addPart(player.x + player.w / 2, player.y + player.h / 2, '#ff4444', 6, 2.5, 18);\\n  if (player.hp <= 0) killPlayer();\\n}\\nfunction killPlayer() {\\n  if (player.dead) return;\\n  player.dead = true; player.deadTimer = 95;\\n  sfx('die');\\n  explosion(player.x + player.w / 2, player.y + player.h / 2, true);\\n}\\nfunction doRespawn() {\\n  lives--;\\n  if (lives <= 0) { state = 'gameover'; sfx('gameover'); return; }\\n  player = makePlayer(respawn.x, respawn.y);\\n  player.invuln = 130;\\n  pBullets = []; eBullets = [];\\n}\\n\\n/* ================= 敌人 ================= */\\nfunction spawnEnemy(type, x, y, optY) {\\n  const base = { type, x, y: 0, w: 12, h: 20, hp: 1, vx: 0, vy: 0, active: false,\\n    timer: 0, seed: Math.random() * 100, fly: false, facing: -1, score: 100, hitFlash: 0, onGround: false };\\n  if (type === 'runner') { base.hp = 1; base.score = 100; }\\n  else if (type === 'shooter') { base.hp = 2; base.score = 200; }\\n  else if (type === 'turret') { base.w = 16; base.h = 16; base.hp = 5; base.score = 300; }\\n  else if (type === 'flier') { base.w = 16; base.h = 12; base.hp = 2; base.score = 200; base.fly = true; }\\n  else if (type === 'elite') { base.h = 22; base.hp = 3; base.score = 300; }\\n  base.x = x * TILE;\\n  if (optY !== undefined) base.y = optY * TILE;\\n  else base.y = (stageDef().ground[x] * TILE) - base.h;\\n  return base;\\n}\\nfunction stageDef() { return STAGES[stage]; }\\n\\nfunction updateEnemies() {\\n  for (let i = enemies.length - 1; i >= 0; i--) {\\n    const e = enemies[i];\\n    if (e.hitFlash > 0) e.hitFlash--;\\n    if (!e.active) {\\n      if (e.x < camX + VW + 50 && e.x + e.w > camX - 60) e.active = true;\\n      continue;\\n    }\\n    e.timer--;\\n    const px = player ? player.x + player.w / 2 : e.x;\\n    const py = player ? player.y : e.y;\\n\\n    if (e.type === 'runner' || e.type === 'elite') {\\n      e.vx = (px > e.x + e.w / 2 ? 0.8 : -0.8);\\n      e.facing = e.vx > 0 ? 1 : -1;\\n      e.vy = Math.min(e.vy + 0.3, 8);\\n      moveEntity(e);\\n    }\\n    else if (e.type === 'shooter') {\\n      const d = Math.abs(px - (e.x + e.w / 2));\\n      if (d < 110) {\\n        e.vx = 0; e.facing = px > e.x + e.w / 2 ? 1 : -1;\\n        if (e.timer <= 0) { fireEnemyBullet(e.x + e.w / 2, e.y + 6, px, py, 2.2, 0.18); e.timer = 75; }\\n      } else {\\n        e.vx = px > e.x + e.w / 2 ? 0.6 : -0.6;\\n        e.facing = e.vx > 0 ? 1 : -1;\\n      }\\n      e.vy = Math.min(e.vy + 0.3, 8);\\n      moveEntity(e);\\n    }\\n    else if (e.type === 'turret') {\\n      e.vx = 0; e.vy = Math.min(e.vy + 0.3, 8);\\n      moveEntity(e);\\n      if (e.timer <= 0 && px > camX - 20 && px < camX + VW + 20) {\\n        fireEnemyBullet(e.x + e.w / 2, e.y + 4, px, py, 2.4, 0.15);\\n        e.timer = 115;\\n      }\\n    }\\n    else if (e.type === 'flier') {\\n      e.vx = (px > e.x + e.w / 2 ? 0.65 : -0.65);\\n      e.vy = Math.sin(time * 0.05 + e.seed) * 0.6;\\n      e.x += e.vx; e.y += e.vy;\\n      e.facing = e.vx > 0 ? 1 : -1;\\n      if (e.x < 4) e.x = 4;\\n      if (e.x + e.w > W * TILE - 4) e.x = W * TILE - 4 - e.w;\\n      if (e.timer <= 0 && px > camX - 20 && px < camX + VW + 20) {\\n        fireEnemyBullet(e.x + e.w / 2, e.y + e.h, px, py, 1.9, 0.22);\\n        e.timer = 105;\\n      }\\n    }\\n    // 与玩家接触\\n    if (player && !player.dead && player.invuln <= 0 && rectsOverlap(player, e)) {\\n      damagePlayer(25);\\n    }\\n    // 生命耗尽\\n    if (e.hp <= 0) {\\n      score += e.score;\\n      explosion(e.x + e.w / 2, e.y + e.h / 2, false);\\n      enemies.splice(i, 1);\\n      continue;\\n    }\\n    // 移出屏幕回收\\n    if (e.x < camX - 140 || e.x > camX + VW + 420) { enemies.splice(i, 1); }\\n  }\\n}\\nfunction fireEnemyBullet(x, y, tx, ty, sp, spread) {\\n  let a = Math.atan2(ty - y, tx - x) + (Math.random() * 2 - 1) * spread;\\n  eBullets.push({ x: x - 3, y: y - 3, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,\\n    w: 6, h: 6, dmg: 20, life: 320, from: 'e', color: '#ff8a3d' });\\n  sfx('eshoot');\\n}\\n\\n/* ================= Boss ================= */\\nfunction makeBoss() {\\n  const def = stageDef();\\n  const w = def.bossType === 'core' ? 60 : 64;\\n  const h = def.bossType === 'core' ? 40 : 44;\\n  const x = def.bossXTile * TILE;\\n  const y = def.bossType === 'core' ? (def.ground[def.bossXTile] * TILE - h) : 60;\\n  return { type: def.bossType, x, y, w, h, hp: def.bossHP, maxHp: def.bossHP,\\n    timer: 80, t2: 100, flash: 0, active: false, dead: false, deathT: 0,\\n    bob: 0, warn: 0, sx: Math.random() * 6 - 3 };\\n}\\nfunction updateBoss() {\\n  if (!boss) return;\\n  if (!boss.active) {\\n    if (player && player.x >= boss.x - VW + 30) {\\n      boss.active = true; boss.warn = 80; sfx('alarm');\\n    }\\n    return;\\n  }\\n  if (boss.dead) {\\n    boss.deathT--;\\n    if (time % 7 === 0) explosion(boss.x + Math.random() * boss.w, boss.y + Math.random() * boss.h, false);\\n    if (boss.deathT <= 0) {\\n      bossCleared = true;\\n      boss = null;\\n      score += 5000;\\n      explosion(boss.x + 30, boss.y + 20, true);\\n      sfx('clear');\\n      if (score > hiScore) { hiScore = score; try { localStorage.setItem('contra_hi', hiScore); } catch (e) {} }\\n    }\\n    return;\\n  }\\n  if (boss.warn > 0) boss.warn--;\\n  if (boss.flash > 0) boss.flash--;\\n  boss.timer--; boss.t2--;\\n  const cx = boss.x + boss.w / 2, cy = boss.y + boss.h / 2;\\n  if (boss.type === 'core') {\\n    if (boss.timer <= 0) {\\n      fireBossBullet(cx, cy, -0.26, 2.6); fireBossBullet(cx, cy, 0, 2.6); fireBossBullet(cx, cy, 0.26, 2.6);\\n      sfx('eshoot');\\n      boss.timer = (boss.hp < boss.maxHp * 0.5) ? 75 : 120;\\n    }\\n    if (boss.t2 <= 0) {\\n      fireBossBullet(cx, cy - 6, 0, 4.4, true);\\n      sfx('charge');\\n      boss.t2 = 250;\\n    }\\n  }\\n  else if (boss.type === 'mother') {\\n    const tx = clamp(player ? player.x + 7 : 0, 20, W * TILE - boss.w - 20);\\n    boss.x += Math.sign(tx - boss.x) * 1.3;\\n    boss.bob += 0.05;\\n    boss.y = clamp(boss.y + Math.sin(boss.bob) * 0.9, 30, 130);\\n    if (boss.timer <= 0) {\\n      fireBossBullet(cx, cy, -0.2, 2.4); fireBossBullet(cx, cy, 0, 2.4); fireBossBullet(cx, cy, 0.2, 2.4);\\n      sfx('eshoot');\\n      boss.timer = 100;\\n    }\\n    if (boss.t2 <= 0) {\\n      eBullets.push({ x: cx - 14, y: cy + boss.h / 2, vx: 0, vy: 2.1, w: 6, h: 6, dmg: 25, life: 300, from: 'e', color: '#aaff66' });\\n      eBullets.push({ x: cx + 8, y: cy + boss.h / 2, vx: 0, vy: 2.1, w: 6, h: 6, dmg: 25, life: 300, from: 'e', color: '#aaff66' });\\n      sfx('drop');\\n      boss.t2 = 190;\\n    }\\n  }\\n  // 接触伤害\\n  if (player && !player.dead && player.invuln <= 0 && rectsOverlap(player, boss)) damagePlayer(30);\\n  // 死亡\\n  if (boss.hp <= 0 && !boss.dead) {\\n    boss.dead = true; boss.deathT = 150;\\n    explosion(boss.x + boss.w / 2, boss.y + boss.h / 2, true);\\n    sfx('big');\\n  }\\n}\\nfunction fireBossBullet(x, y, off, sp, big) {\\n  const px = player ? player.x + player.w / 2 : x + 100;\\n  const py = player ? player.y + player.h / 2 : y;\\n  const a = Math.atan2(py - y, px - x) + off;\\n  eBullets.push({ x: x - 3, y: y - 3, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,\\n    w: big ? 10 : 6, h: big ? 10 : 6, dmg: big ? 40 : 30, life: 280, from: 'e', color: big ? '#ff2d6f' : '#ff8a3d' });\\n}\\n\\n/* ================= 子弹 ================= */\\nfunction updateBullets() {\\n  // 玩家子弹\\n  for (let i = pBullets.length - 1; i >= 0; i--) {\\n    const b = pBullets[i];\\n    b.x += b.vx; b.y += b.vy; b.life--;\\n    if (b.life <= 0) { pBullets.splice(i, 1); continue; }\\n    const tx = Math.floor((b.x + b.w / 2) / TILE), ty = Math.floor((b.y + b.h / 2) / TILE);\\n    const t = tileAt(tx, ty);\\n    if (t === T_SOLID || t === T_SPIKE) { pBullets.splice(i, 1); continue; }\\n    if (t === T_BRICK) {\\n      const k = brickKey(tx, ty);\\n      const hp = (brickHp.get(k) || 3) - 1;\\n      brickHp.set(k, hp);\\n      addPart(b.x, b.y, '#aaa', 3, 1.6, 12);\\n      if (hp <= 0) { map[tx][ty] = T_EMPTY; addPart(tx * TILE + 8, ty * TILE + 8, '#999', 6, 2.4, 18); }\\n      pBullets.splice(i, 1); continue;\\n    }\\n    // 命中敌人\\n    let hit = false;\\n    for (const e of enemies) {\\n      if (e.active && rectsOverlap(b, e)) { e.hp -= b.dmg; e.hitFlash = 5; hit = true; sfx('hit'); break; }\\n    }\\n    if (!hit && boss && boss.active && !boss.dead && rectsOverlap(b, boss)) {\\n      boss.hp -= b.dmg; boss.flash = 5; hit = true; sfx('hit');\\n    }\\n    if (!hit) {\\n      for (const it of items) {\\n        if (!it.open && rectsOverlap(b, it)) { it.open = true; spawnPickup(it); hit = true; break; }\\n      }\\n    }\\n    if (hit) pBullets.splice(i, 1);\\n  }\\n  // 敌人子弹\\n  for (let i = eBullets.length - 1; i >= 0; i--) {\\n    const b = eBullets[i];\\n    b.x += b.vx; b.y += b.vy; b.life--;\\n    if (b.life <= 0) { eBullets.splice(i, 1); continue; }\\n    const tx = Math.floor((b.x + b.w / 2) / TILE), ty = Math.floor((b.y + b.h / 2) / TILE);\\n    const t = tileAt(tx, ty);\\n    if (t === T_SOLID || t === T_BRICK || t === T_SPIKE) { eBullets.splice(i, 1); continue; }\\n    if (player && !player.dead && player.invuln <= 0 && rectsOverlap(b, player)) {\\n      damagePlayer(b.dmg); eBullets.splice(i, 1);\\n    }\\n  }\\n}\\n\\n/* ================= 道具 ================= */\\nfunction spawnPickup(it) {\\n  const letters = { M: '#66ccff', S: '#66ff88', R: '#ffdd55', H: '#ff6677' };\\n  pickups.push({ x: it.x * TILE, y: it.y * TILE, w: 12, h: 12, letter: it.letter,\\n    vy: 0, onGround: false, color: letters[it.letter] || '#fff' });\\n  sfx('pickup');\\n}\\nfunction updateItems() {\\n  for (const it of items) {\\n    it.bob = (it.bob || 0) + 0.05;\\n    if (it.open && pickups.length < 30) {\\n      // 若已打开但未生成（防重复）\\n    }\\n  }\\n  for (let i = pickups.length - 1; i >= 0; i--) {\\n    const pk = pickups[i];\\n    if (!pk.onGround) {\\n      pk.vy = Math.min(pk.vy + 0.3, 8);\\n      pk.y += pk.vy;\\n      if (pk.y > (stageDef().ground[Math.floor(pk.x / TILE)] * TILE) - pk.h) {\\n        pk.y = stageDef().ground[Math.floor(pk.x / TILE)] * TILE - pk.h;\\n        pk.onGround = true;\\n      }\\n    }\\n    if (player && !player.dead && rectsOverlap(player, pk)) {\\n      applyPickup(pk);\\n      pickups.splice(i, 1);\\n      continue;\\n    }\\n    if (pk.y > MAP_H * TILE) pickups.splice(i, 1);\\n  }\\n}\\nfunction applyPickup(pk) {\\n  if (pk.letter === 'M') { player.weapon = 'm'; player.weaponTime = 60 * 30; }\\n  else if (pk.letter === 'S') { player.weapon = 's'; player.weaponTime = 60 * 30; }\\n  else if (pk.letter === 'R') { player.weapon = 'r'; player.weaponTime = 60 * 30; }\\n  else if (pk.letter === 'H') { player.hp = Math.min(player.maxHp, player.hp + 40); }\\n  score += 500;\\n  sfx('power');\\n  addPart(pk.x + 6, pk.y + 6, '#ffffff', 10, 2.4, 20);\\n}\\n\\n/* ================= 相机 / 检查点 ================= */\\nfunction updateCamera() {\\n  if (!player) return;\\n  let maxCam = W * TILE - VW;\\n  if (boss && !bossCleared && boss.active) maxCam = Math.min(maxCam, boss.x - 70);\\n  camX = clamp(player.x + player.w / 2 - VW / 2 + player.facing * 22, 0, maxCam);\\n  camY = clamp(player.y + player.h / 2 - VH / 2 + 10, 0, MAP_H * TILE - VH);\\n}\\nfunction updateCheckpoint() {\\n  if (!player || !respawn) return;\\n  const def = stageDef();\\n  for (const c of def.checkpoints) {\\n    if (player.x > c * TILE && c > respawn.tile) {\\n      respawn = { x: c * TILE, y: (def.ground[c] * TILE) - 20, tile: c };\\n    }\\n  }\\n}\\nfunction checkEnd() {\\n  if (bossCleared && player && player.x >= W * TILE - 8 && !ended) {\\n    ended = true;\\n    state = 'stageClear';\\n    stateTimer = 160;\\n    sfx('clear');\\n  }\\n}\\n\\n/* ================= 关卡流程 ================= */\\nfunction startGame() {\\n  score = 0; lives = 3; stage = 0;\\n  initStage();\\n}\\nfunction initStage() {\\n  const def = stageDef();\\n  W = def.W;\\n  map = buildMap(def);\\n  camX = 0; camY = 0; shake = 0;\\n  player = makePlayer(2 * TILE, (def.ground[2] * TILE) - 20);\\n  respawn = { x: 2 * TILE, y: (def.ground[2] * TILE) - 20, tile: 2 };\\n  enemies = def.enemies.map(e => spawnEnemy(e[0], e[1], 0, e[2]));\\n  pBullets = []; eBullets = []; pickups = []; parts = [];\\n  items = def.items.map(it => ({ x: it.x, y: it.y, letter: it.letter, open: false, bob: 0, w: 14, h: 14 }));\\n  boss = makeBoss();\\n  bossLocked = false; bossCleared = false; ended = false;\\n  brickHp = new Map();\\n  paused = false;\\n}\\n\\n/* ================= 更新主逻辑 ================= */\\nfunction step() {\\n  time++;\\n  const jE = just.has('jump');\\n  jumpHeld = hold.jump;\\n  shootHeld = hold.shoot;\\n  startPressed = just.has('start'); just.delete('start');\\n  pausePressed = just.has('pause'); just.delete('pause');\\n  mutePressed = just.has('mute'); just.delete('mute');\\n  if (mutePressed) muted = !muted;\\n  if (pausePressed && state === 'playing') paused = !paused;\\n\\n  if (state === 'title') {\\n    if (startPressed || jE) { ensureAudio(); state = 'intro'; stateTimer = 100; introText = stageDef().name + ' ' + stageDef().sub; }\\n    return;\\n  }\\n  if (state === 'intro') {\\n    stateTimer--;\\n    if (stateTimer <= 0 || startPressed) state = 'playing';\\n    return;\\n  }\\n  if (state === 'stageClear') {\\n    stateTimer--;\\n    if (startPressed || stateTimer <= 0) {\\n      if (stage < STAGES.length - 1) {\\n        stage++;\\n        initStage();\\n        state = 'intro'; stateTimer = 100;\\n        introText = stageDef().name + ' ' + stageDef().sub;\\n      } else {\\n        state = 'victory';\\n      }\\n    }\\n    return;\\n  }\\n  if (state === 'gameover') {\\n    if (startPressed || jE) startGame();\\n    return;\\n  }\\n  if (state === 'victory') {\\n    if (startPressed || jE) startGame();\\n    return;\\n  }\\n  if (state === 'playing') {\\n    if (paused) return;\\n    updatePlayer();\\n    updateEnemies();\\n    updateBoss();\\n    updateBullets();\\n    updateItems();\\n    updateParticles();\\n    updateCamera();\\n    updateCheckpoint();\\n    checkEnd();\\n  }\\n}\\n\\n/* ================= 渲染 ================= */\\nfunction px(x, y, w, h, c) { ctx.fillStyle = c; ctx.fillRect(x, y, w, h); }\\nfunction R(e, x, y, w, h, c) {\\n  const sx = e.x - camX, f = e.facing;\\n  const rx = f > 0 ? sx + x : sx + e.w - x - w;\\n  ctx.fillStyle = c; ctx.fillRect(rx, e.y - camY + y, w, h);\\n}\\n\\nfunction drawBackground() {\\n  const def = stageDef();\\n  const theme = def.theme;\\n  if (theme === 'jungle') {\\n    const g = ctx.createLinearGradient(0, 0, 0, VH);\\n    g.addColorStop(0, '#12406e'); g.addColorStop(0.5, '#2f6db0'); g.addColorStop(1, '#6fb2dd');\\n    ctx.fillStyle = g; ctx.fillRect(0, 0, VW, VH);\\n    px(272, 14, 22, 22, '#ffe9a0');\\n    px(274, 16, 18, 18, '#fff3c4');\\n    const off1 = Math.floor(camX * 0.2) % 128;\\n    for (let i = -1; i < 5; i++) {\\n      const mx = i * 128 - off1;\\n      ctx.fillStyle = '#245a3c';\\n      ctx.beginPath(); ctx.moveTo(mx, 84); ctx.lineTo(mx + 64, 26); ctx.lineTo(mx + 128, 84); ctx.fill();\\n    }\\n    const off2 = Math.floor(camX * 0.45) % 64;\\n    for (let i = -1; i < 8; i++) {\\n      const mx = i * 64 - off2;\\n      ctx.fillStyle = '#2f7a4a';\\n      ctx.fillRect(mx, 60, 26, 24);\\n      ctx.beginPath(); ctx.arc(mx + 13, 60, 15, 0, Math.PI * 2); ctx.fill();\\n    }\\n    const off3 = Math.floor(camX * 0.7) % 48;\\n    for (let i = -1; i < 10; i++) {\\n      const mx = i * 48 - off3;\\n      ctx.fillStyle = '#1d4d2a';\\n      ctx.fillRect(mx + 8, 92, 6, 40);\\n      ctx.beginPath(); ctx.arc(mx + 11, 88, 12, 0, Math.PI * 2); ctx.fill();\\n    }\\n  } else {\\n    const g = ctx.createLinearGradient(0, 0, 0, VH);\\n    g.addColorStop(0, '#17061f'); g.addColorStop(0.6, '#3d1030'); g.addColorStop(1, '#6a1f28');\\n    ctx.fillStyle = g; ctx.fillRect(0, 0, VW, VH);\\n    const off1 = Math.floor(camX * 0.2) % 96;\\n    for (let i = -1; i < 6; i++) {\\n      const mx = i * 96 - off1;\\n      ctx.fillStyle = '#201030';\\n      ctx.fillRect(mx + 20, 50, 26, 110);\\n      ctx.fillRect(mx + 10, 74, 8, 20); ctx.fillRect(mx + 48, 64, 8, 24);\\n    }\\n    const off2 = Math.floor(camX * 0.5) % 64;\\n    for (let i = -1; i < 8; i++) {\\n      const mx = i * 64 - off2;\\n      ctx.fillStyle = '#331426';\\n      ctx.fillRect(mx + 8, 96, 4, 60); ctx.fillRect(mx + 24, 96, 4, 60);\\n      ctx.fillRect(mx, 94, 36, 4);\\n    }\\n  }\\n}\\n\\nfunction drawTiles() {\\n  const x0 = Math.floor(camX / TILE), x1 = Math.min(W - 1, Math.ceil((camX + VW) / TILE));\\n  const y0 = Math.floor(camY / TILE), y1 = Math.min(MAP_H - 1, Math.ceil((camY + VH) / TILE));\\n  const theme = stageDef().theme;\\n  for (let x = x0; x <= x1; x++) for (let y = y0; y <= y1; y++) {\\n    const t = map[x][y];\\n    const sx = x * TILE - camX, sy = y * TILE - camY;\\n    if (t === T_SOLID) {\\n      if (theme === 'jungle') {\\n        px(sx, sy, TILE, TILE, (y > 0 && map[x][y - 1] !== T_SOLID) ? '#4a8f3f' : '#6a4a2a');\\n        if (y > 0 && map[x][y - 1] !== T_SOLID) {\\n          px(sx, sy + 3, TILE, 2, '#3f7a35');\\n          px(sx + 3, sy + 8, 3, 1, '#3f7a35');\\n        }\\n      } else {\\n        px(sx, sy, TILE, TILE, '#5a5a68');\\n        px(sx, sy, TILE, 3, '#75758a');\\n        px(sx, sy + 10, 2, 4, '#454555'); px(sx + 10, sy + 3, 2, 4, '#454555');\\n      }\\n    } else if (t === T_PLAT) {\\n      if (theme === 'jungle') {\\n        px(sx, sy, TILE, 5, '#4a8f3f'); px(sx, sy + 5, TILE, 2, '#3f7a35'); px(sx, sy + 7, TILE, 2, '#2c5425');\\n      } else {\\n        px(sx, sy, TILE, 5, '#77778c'); px(sx, sy + 5, TILE, 2, '#55556a'); px(sx, sy + 7, TILE, 2, '#3a3a4a');\\n      }\\n    } else if (t === T_SPIKE) {\\n      ctx.fillStyle = '#c9c9d6';\\n      ctx.beginPath(); ctx.moveTo(sx, sy + TILE); ctx.lineTo(sx + 8, sy + 2); ctx.lineTo(sx + 16, sy + TILE); ctx.closePath(); ctx.fill();\\n      ctx.fillStyle = '#f2f2f8';\\n      ctx.beginPath(); ctx.moveTo(sx, sy + TILE); ctx.lineTo(sx + 8, sy + 2); ctx.lineTo(sx + 8, sy + TILE); ctx.closePath(); ctx.fill();\\n    } else if (t === T_BRICK) {\\n      px(sx, sy, TILE, TILE, '#9a9a4a');\\n      px(sx, sy, TILE, 2, '#cfcf6a'); px(sx, sy + 8, TILE, 2, '#6a6a30');\\n      px(sx + 4, sy + 2, 2, 6, '#7a7a3a'); px(sx + 10, sy + 10, 2, 6, '#7a7a3a');\\n    } else if (t === T_WATER) {\\n      const wave = Math.sin(time * 0.1 + x) > 0;\\n      if (theme === 'jungle') px(sx, sy, TILE, TILE, wave ? '#1b6fb8' : '#1460a0');\\n      else px(sx, sy, TILE, TILE, wave ? '#ff5a1a' : '#e04a10');\\n    }\\n  }\\n}\\n\\nfunction drawPlayer() {\\n  const p = player;\\n  if (!p) return;\\n  if (p.dead) return;\\n  if (p.invuln > 0 && Math.floor(time / 3) % 2 === 0 && state === 'playing') return; // 闪烁无敌\\n  const sx = p.x - camX, sy = p.y - camY, f = p.facing;\\n  const fl = (x, w) => f > 0 ? sx + x : sx + p.w - x - w;\\n  if (p.crouch) {\\n    px(fl(1, 12), sy + 4, 12, 8, '#d33');          // 躯干\\n    px(fl(4, 6), sy + 0, 6, 5, '#e8c39a');         // 头\\n    px(fl(4, 6), sy + 0, 6, 2, '#c22');            // 头巾\\n    px(fl(2, 3), sy + 10, 3, 2, '#5a7fc0');        // 腿\\n    px(fl(9, 3), sy + 10, 3, 2, '#5a7fc0');\\n    px(fl(11, 6), sy + 3, 6, 2, '#999');           // 枪\\n  } else {\\n    // 腿动画\\n    let l1 = 2, l2 = 9;\\n    if (p.onGround && Math.abs(p.vx) > 0.1) {\\n      const fr = Math.floor(p.anim / 4) % 2;\\n      if (fr === 0) { l1 = 2; l2 = 9; } else { l1 = 3; l2 = 8; }\\n      p.anim++;\\n    }\\n    if (!p.onGround) { l1 = 4; l2 = 7; }\\n    px(fl(l1, 3), sy + 13, 3, 7, '#5a7fc0');\\n    px(fl(l2, 3), sy + 13, 3, 7, '#4470b0');\\n    px(fl(3, 8), sy + 7, 8, 6, '#d33');            // 躯干红\\n    px(fl(4, 6), sy + 2, 6, 5, '#e8c39a');         // 头\\n    px(fl(4, 6), sy + 1, 6, 2, '#c22');            // 红头巾\\n    px(fl(1, 3), sy + 8, 3, 3, '#e8c39a');         // 后臂\\n    const gunY = p.facing > 0 ? 8 : 8;\\n    px(fl(10, 3), sy + gunY, 3, 3, '#e8c39a');     // 前臂\\n    px(fl(12, 6), sy + gunY, 6, 2, '#999');        // 枪身\\n    px(fl(17, 2), sy + gunY, 2, 2, '#666');        // 枪口\\n  }\\n  // 手持武器提示\\n  if (p.weapon !== 'rifle') {\\n    const c = p.weapon === 'm' ? '#66ccff' : p.weapon === 's' ? '#66ff88' : '#ffdd55';\\n    ctx.font = 'bold 6px monospace'; ctx.fillStyle = c;\\n    ctx.fillText(p.weapon.toUpperCase(), sx + 3, sy + 2);\\n  }\\n}\\nfunction drawEnemies() {\\n  for (const e of enemies) {\\n    const sx = e.x - camX;\\n    if (sx < -40 || sx > VW + 40) continue;\\n    const flash = e.hitFlash > 0;\\n    const col = flash ? '#ffffff' : null;\\n    if (e.type === 'runner' || e.type === 'elite') {\\n      const c1 = e.type === 'elite' ? '#c33' : '#b04a8a';\\n      R(e, 2, 13, 3, 7, flash ? '#fff' : '#3a5a8a', e.facing);\\n      R(e, 9, 13, 3, 7, flash ? '#fff' : '#3a5a8a', e.facing);\\n      R(e, 3, 7, 8, 6, flash ? '#fff' : c1, e.facing);\\n      R(e, 4, 2, 6, 5, flash ? '#fff' : '#e8c39a', e.facing);\\n      R(e, 11, 7, 6, 2, flash ? '#fff' : '#999', e.facing);\\n    } else if (e.type === 'shooter') {\\n      R(e, 2, 13, 3, 7, flash ? '#fff' : '#5a6a7a', e.facing);\\n      R(e, 9, 13, 3, 7, flash ? '#fff' : '#5a6a7a', e.facing);\\n      R(e, 3, 7, 8, 6, flash ? '#fff' : '#8a8a9a', e.facing);\\n      R(e, 4, 2, 6, 5, flash ? '#fff' : '#e8c39a', e.facing);\\n      R(e, 12, 6, 7, 3, flash ? '#fff' : '#555', e.facing);\\n    } else if (e.type === 'turret') {\\n      const sy = e.y - camY;\\n      px(e.x - camX, sy, e.w, 5, flash ? '#fff' : '#5a5a68');\\n      px(e.x - camX + 2, sy - 6, 12, 6, flash ? '#fff' : '#77778c');\\n      const bx = e.facing > 0 ? e.x - camX + 12 : e.x - camX - 6;\\n      px(bx, sy - 5, 6, 4, flash ? '#fff' : '#444');\\n    } else if (e.type === 'flier') {\\n      const sy = e.y - camY;\\n      const flap = Math.sin(time * 0.3 + e.seed) * 3;\\n      px(e.x - camX, sy + 6, 16, 6, flash ? '#fff' : '#3f8f3f');\\n      px(e.x - camX + 3, sy, 4, 6, flash ? '#fff' : '#2f7a2f');\\n      px(e.x - camX - 4, sy + 4 + flap, 6, 3, flash ? '#fff' : '#55aa55');\\n      px(e.x - camX + 14, sy + 4 - flap, 6, 3, flash ? '#fff' : '#55aa55');\\n      ctx.fillStyle = flash ? '#fff' : '#ffdd55';\\n      ctx.fillRect(e.x - camX + 12, sy + 7, 2, 2);\\n    }\\n  }\\n}\\nfunction drawBoss() {\\n  if (!boss) return;\\n  const sx = boss.x - camX, sy = boss.y - camY;\\n  const f = boss.flash > 0 ? '#ffffff' : null;\\n  if (boss.type === 'core') {\\n    px(sx, sy + 20, 60, 20, f || '#55556a');                 // 底座\\n    px(sx + 6, sy + 6, 48, 20, f || '#77778c');              // 主体\\n    px(sx + 6, sy + 6, 48, 4, f || '#9a9ab0');               // 高光\\n    ctx.fillStyle = f || '#2a2a3a';\\n    ctx.fillRect(sx + 24, sy + 12, 12, 10);                  // 炮口\\n    ctx.fillStyle = f || '#ff4455';\\n    ctx.fillRect(sx + 26, sy + 14, 8, 6);                    // 红眼\\n    ctx.fillStyle = f || '#ffdd55';\\n    ctx.fillRect(sx + 4, sy + 28, 4, 6); ctx.fillRect(sx + 52, sy + 28, 4, 6); // 警示灯\\n    if (boss.warn > 0 && Math.floor(time / 4) % 2 === 0) {\\n      ctx.fillStyle = 'rgba(255,0,0,0.25)';\\n      ctx.fillRect(sx + 6, sy, 48, 40);\\n    }\\n  } else {\\n    // 外星母体：飞碟\\n    ctx.beginPath(); ctx.ellipse(sx + 32, sy + 28, 30, 12, 0, 0, Math.PI * 2);\\n    ctx.fillStyle = f || '#3a8a5a'; ctx.fill();\\n    ctx.beginPath(); ctx.ellipse(sx + 32, sy + 18, 16, 10, 0, 0, Math.PI * 2);\\n    ctx.fillStyle = f || '#55aa6a'; ctx.fill();\\n    px(sx + 28, sy + 10, 8, 6, f || '#ffdd55');              // 驾驶窗\\n    ctx.fillStyle = f || '#ff4455';\\n    for (let i = 0; i < 4; i++) ctx.fillRect(sx + 6 + i * 16, sy + 24, 4, 5); // 下挂炮\\n  }\\n}\\nfunction drawBullets() {\\n  for (const b of pBullets) {\\n    ctx.fillStyle = b.color;\\n    ctx.fillRect(b.x - camX, b.y - camY, b.w, b.h);\\n  }\\n  for (const b of eBullets) {\\n    ctx.fillStyle = b.color;\\n    ctx.fillRect(b.x - camX, b.y - camY, b.w, b.h);\\n    ctx.fillStyle = 'rgba(255,255,255,0.5)';\\n    ctx.fillRect(b.x - camX + 1, b.y - camY + 1, b.w - 2, b.h - 2);\\n  }\\n}\\nfunction drawItems() {\\n  for (const it of items) {\\n    const sx = it.x * TILE - camX, sy = it.y * TILE - camY + Math.sin(it.bob) * 2;\\n    // 飞行补给箱\\n    ctx.fillStyle = '#c22';\\n    ctx.fillRect(sx, sy + 2, 14, 8);\\n    ctx.fillStyle = '#ffdd55';\\n    ctx.fillRect(sx + 1, sy + 3, 12, 2);\\n    ctx.fillStyle = '#e8c39a';\\n    ctx.fillRect(sx - 2, sy + 6, 18, 3);\\n    ctx.font = 'bold 8px monospace'; ctx.fillStyle = '#fff';\\n    ctx.fillText(it.letter, sx + 4, sy + 10);\\n  }\\n  for (const pk of pickups) {\\n    const sx = pk.x - camX, sy = pk.y - camY;\\n    ctx.fillStyle = pk.color;\\n    ctx.fillRect(sx, sy, 12, 12);\\n    ctx.fillStyle = '#fff';\\n    ctx.font = 'bold 8px monospace';\\n    ctx.fillText(pk.letter, sx + 3, sy + 10);\\n  }\\n}\\nfunction drawParticles() {\\n  for (const p of parts) {\\n    const a = p.life / p.ttl;\\n    ctx.globalAlpha = a;\\n    ctx.fillStyle = p.color;\\n    ctx.fillRect(p.x - camX, p.y - camY, p.size, p.size);\\n  }\\n  ctx.globalAlpha = 1;\\n}\\n\\n/* ---------- HUD ---------- */\\nfunction drawHUD() {\\n  ctx.font = 'bold 8px monospace';\\n  ctx.fillStyle = '#fff';\\n  ctx.fillText('SCORE', 4, 8);\\n  ctx.fillText(String(score).padStart(7, '0'), 4, 17);\\n  ctx.fillStyle = '#ffd';\\n  ctx.fillText('HI', 84, 8);\\n  ctx.fillText(String(hiScore).padStart(7, '0'), 84, 17);\\n  ctx.fillStyle = '#fff';\\n  ctx.fillText(stageDef().name, 168, 8);\\n  ctx.fillText(stageDef().sub, 168, 17);\\n  // 生命\\n  for (let i = 0; i < lives; i++) {\\n    px(4 + i * 10, 24, 7, 9, '#e33');\\n    px(5 + i * 10, 23, 5, 2, '#e33');\\n  }\\n  // HP 条\\n  if (player) {\\n    ctx.fillStyle = '#333';\\n    ctx.fillRect(168, 26, 66, 5);\\n    const r = clamp(player.hp / player.maxHp, 0, 1);\\n    ctx.fillStyle = r > 0.5 ? '#3f3' : (r > 0.25 ? '#ff3' : '#f33');\\n    ctx.fillRect(169, 27, 64 * r, 3);\\n    ctx.fillStyle = '#aaa';\\n    ctx.fillText('HP', 160, 32);\\n  }\\n  // 武器\\n  if (player && player.weapon !== 'rifle') {\\n    const wc = player.weapon === 'm' ? '#66ccff' : player.weapon === 's' ? '#66ff88' : '#ffdd55';\\n    ctx.fillStyle = wc;\\n    ctx.fillText('W:' + player.weapon.toUpperCase(), 262, 17);\\n    ctx.fillStyle = '#888';\\n    ctx.fillText(Math.ceil(player.weaponTime / 60) + 's', 262, 26);\\n  }\\n}\\nfunction drawBossBar() {\\n  if (!boss) return;\\n  ctx.fillStyle = 'rgba(0,0,0,0.6)';\\n  ctx.fillRect(36, 4, 248, 10);\\n  ctx.fillStyle = '#c22';\\n  ctx.fillRect(38, 6, 244 * clamp(boss.hp / boss.maxHp, 0, 1), 6);\\n  ctx.fillStyle = '#fff';\\n  ctx.font = 'bold 7px monospace';\\n  ctx.fillText('BOSS', 8, 13);\\n  if (boss.warn > 0 && Math.floor(time / 4) % 2 === 0) {\\n    ctx.fillStyle = '#f33';\\n    ctx.font = 'bold 10px monospace';\\n    ctx.fillText('WARNING!', VW / 2 - 36, 40);\\n  }\\n}\\n\\n/* ---------- 界面 ---------- */\\nfunction darkOverlay(a) { ctx.fillStyle = 'rgba(0,0,0,' + a + ')'; ctx.fillRect(0, 0, VW, VH); }\\nfunction centerText(txt, y, size, color, font) {\\n  ctx.font = (font || 'bold ' + size + 'px') + ' monospace';\\n  ctx.fillStyle = color || '#fff';\\n  ctx.textAlign = 'center';\\n  ctx.fillText(txt, VW / 2, y);\\n  ctx.textAlign = 'left';\\n}\\nfunction drawTitle() {\\n  darkOverlay(0.35);\\n  centerText('魂 斗 罗', 74, 30, '#f33', 'bold 30px \\\"Microsoft YaHei\\\",\\\"SimHei\\\",sans-serif');\\n  centerText('CONTRA', 92, 12, '#ffd', 'bold 12px monospace');\\n  centerText('RUN & GUN', 104, 8, '#aaf', 'bold 8px monospace');\\n  // 操作说明\\n  ctx.font = '8px \\\"Microsoft YaHei\\\",sans-serif';\\n  ctx.fillStyle = '#fff';\\n  ctx.textAlign = 'center';\\n  const lines = [\\n    '←→ / AD : 移动       ↑ / W : 向上瞄准',\\n    '↓ / S : 下蹲         Z / J / 空格 : 射击',\\n    'X / K : 跳跃         P / Esc : 暂停',\\n    'M : 静音'\\n  ];\\n  lines.forEach((l, i) => ctx.fillText(l, VW / 2, 150 + i * 12));\\n  ctx.textAlign = 'left';\\n  // 武器说明\\n  centerText('M=机枪  S=散弹  R=连发  H=恢复', 208, 8, '#8f8', 'bold 8px monospace');\\n  if (Math.floor(time / 30) % 2 === 0) centerText('按 ENTER 开始', VH - 16, 10, '#ffd', 'bold 10px monospace');\\n}\\nfunction drawIntro() {\\n  darkOverlay(0.55);\\n  centerText(introText, 104, 18, '#ffd', 'bold 18px \\\"Microsoft YaHei\\\",sans-serif');\\n  centerText('准备战斗!', 134, 12, '#f88', 'bold 12px \\\"Microsoft YaHei\\\",sans-serif');\\n}\\nfunction drawStageClear() {\\n  darkOverlay(0.5);\\n  centerText('STAGE CLEAR!', 96, 22, '#ffd', 'bold 22px monospace');\\n  centerText('得分 ' + score, 124, 12, '#fff');\\n  if (stage < STAGES.length - 1) {\\n    if (Math.floor(time / 30) % 2 === 0) centerText('按 ENTER 进入下一关', 160, 9, '#8f8');\\n  }\\n}\\nfunction drawGameOver() {\\n  darkOverlay(0.6);\\n  centerText('GAME OVER', 100, 24, '#f33', 'bold 24px monospace');\\n  centerText('最终得分  ' + score, 130, 12, '#fff');\\n  centerText('最高分  ' + hiScore, 146, 9, '#aaf');\\n  if (Math.floor(time / 30) % 2 === 0) centerText('按 ENTER 重新开始', 174, 9, '#ffd');\\n}\\nfunction drawVictory() {\\n  darkOverlay(0.55);\\n  centerText('MISSION COMPLETE!', 92, 20, '#ffd', 'bold 20px monospace');\\n  centerText('最终得分  ' + score, 122, 12, '#fff');\\n  centerText('最高分  ' + hiScore, 138, 9, '#aaf');\\n  centerText('恭喜通关! 感谢游玩', 162, 12, '#8f8', 'bold 12px \\\"Microsoft YaHei\\\",sans-serif');\\n  if (Math.floor(time / 30) % 2 === 0) centerText('按 ENTER 再来一次', 184, 9, '#ffd');\\n}\\nfunction drawPause() {\\n  darkOverlay(0.5);\\n  centerText('PAUSED', VH / 2, 18, '#fff', 'bold 18px monospace');\\n  centerText('按 P 继续', VH / 2 + 22, 8, '#aaa');\\n}\\n\\nfunction render() {\\n  ctx.save();\\n  if (shake > 0) {\\n    ctx.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake);\\n    shake = Math.max(0, shake - 0.4);\\n  }\\n  drawBackground();\\n  if (map) drawTiles();\\n  if (map) drawItems();\\n  if (map) drawBoss();\\n  if (map) drawEnemies();\\n  if (map && state !== 'title') drawPlayer();\\n  if (map) drawBullets();\\n  drawParticles();\\n  drawHUD();\\n  if (state === 'title') drawTitle();\\n  if (state === 'intro') drawIntro();\\n  if (state === 'stageClear') drawStageClear();\\n  if (state === 'gameover') drawGameOver();\\n  if (state === 'victory') drawVictory();\\n  if (boss && boss.active && !boss.dead) drawBossBar();\\n  if (paused && state === 'playing') drawPause();\\n  ctx.restore();\\n}\\n\\n/* ================= 主循环 ================= */\\nconst STEP = 1000 / 60;\\nlet last = 0, acc = 0;\\nfunction frame(ts) {\\n  if (!last) last = ts;\\n  acc += Math.min(ts - last, 100);\\n  last = ts;\\n  while (acc >= STEP) { step(); acc -= STEP; }\\n  render();\\n  requestAnimationFrame(frame);\\n}\\n// 暴露用于测试\\nwindow.__step = step;\\nwindow.__startGame = startGame;\\nwindow.__initStage = initStage;\\n\\nrequestAnimationFrame(frame);\\n</script>\\n</body>\\n</html>\\nHTMLEOF\\necho \\\"written: $(wc -l < /home/lab/Documents/trae_projects/new-start-wt/contra-game/index.html) lines\\\"\"}}]},{\"role\":\"tool\",\"content\":\"{\\\"exit_code\\\":0,\\\"stderr\\\":\\\"\\\",\\\"stdout\\\":\\\"written: 1170 lines\\\\n\\\",\\\"timed_out\\\":false}\",\"tool_call_id\":\"call_00_VLf0wQTvsEISGDEb91Wi3510\"},{\"role\":\"assistant\",\"content\":\"文件已写入（1170 行）。现在提取 JS 做语法检查，并写一个带 DOM/Canvas 桩的冒烟测试，验证游戏逻辑能跑通：\",\"tool_calls\":[{\"id\":\"call_00_i5iCSTBHkGQtqBkOneXN5576\",\"name\":\"execute_command\",\"arguments\":{\"command\":\"cd /home/lab/Documents/trae_projects/new-start-wt/contra-game && python3 - <<'PYEOF'\\nimport re\\nhtml = open('index.html', encoding='utf-8').read()\\nm = re.search(r'<script>(.*?)</script>', html, re.S)\\njs = m.group(1)\\nopen('_game.js','w',encoding='utf-8').write(js)\\nprint(\\\"extracted\\\", len(js), \\\"chars\\\")\\nPYEOF\\nnode --check _game.js && echo \\\"SYNTAX OK\\\"\"}}]},{\"role\":\"tool\",\"content\":\"{\\\"exit_code\\\":0,\\\"stderr\\\":\\\"\\\",\\\"stdout\\\":\\\"extracted 43510 chars\\\\nSYNTAX OK\\\\n\\\",\\\"timed_out\\\":false}\",\"tool_call_id\":\"call_00_i5iCSTBHkGQtqBkOneXN5576\"},{\"role\":\"user\",\"content\":\"【课题简报】\\n课题：开发可玩的魂斗罗游戏\\n目标：从零开发一个魂斗罗风格、可直接游玩的横版射击游戏\\n进度：0%\\n待办清单：\\n- [ ] 明确魂斗罗的玩法定位、核心机制与技术选型\\n    验收：确定游戏类型（横版卷轴射击）、操作方式、关卡目标、胜负条件与生命机制，并选定实现方案（如 HTML5 Canvas、Unity 等）\\n- [ ] 实现玩家控制与基础射击战斗\\n    验收：玩家角色可在横向场景中移动、跳跃、射击，子弹命中敌人后造成伤害，敌人死亡有反馈\\n- [ ] 实现关卡、敌人与武器道具\\n    验收：至少 1 个完整关卡，包含敌人刷新/布点、可拾取的武器道具（如机枪、散弹），并以关底 Boss 或通关结算收尾，过关条件可触发\\n- [ ] 完成可运行版本并交付\\n    验收：操作流畅、有基础动画/音效，能打包为可直接打开运行的文件，并提供简要操作说明\\n本轮任务：基于上述课题，选择一件尚未完成的事项推进；必要时调用可用工具执行，并在回复中说明本轮进展。若所有事项均已完成，输出完成总结。\"},{\"role\":\"assistant\",\"content\":\"语法检查通过。现在写一个带 DOM/Canvas 桩的冒烟测试，模拟标题→开始→游戏→推进到 Boss→通关的完整流程，验证逻辑无运行时错误：\",\"tool_calls\":[{\"id\":\"call_00_1IN4mmfWGb2Rrsjqdiwu4560\",\"name\":\"execute_command\",\"arguments\":{\"command\":\"cd /home/lab/Documents/trae_projects/new-start-wt/contra-game && cat > _test.js <<'JSEOF'\\n// ---- 桩环境 ----\\nfunction makeCtx() {\\n  return {\\n    fillStyle:'',font:'',globalAlpha:1,textAlign:'left',\\n    fillRect(){},strokeRect(){},beginPath(){},moveTo(){},lineTo(){},closePath(){},\\n    arc(){},ellipse(){},fill(){},stroke(){},translate(){},save(){},restore(){},\\n    createLinearGradient(){ return {addColorStop(){}}; },\\n    fillText(){}\\n  };\\n}\\nconst canvas = { width:320, height:240, getContext:()=>makeCtx() };\\nfunction fakeEl(){ return { addEventListener(){}, style:{} }; }\\nglobal.document = {\\n  getElementById:(id)=> id==='game' ? canvas : fakeEl(),\\n  createElement:()=>fakeEl()\\n};\\nglobal.window = { addEventListener(){}, AudioContext:undefined, webkitAudioContext:undefined };\\nglobal.localStorage = { getItem:()=>null, setItem(){} };\\nglobal.requestAnimationFrame = (fn)=>{};\\n\\n// ---- 加载游戏代码 ----\\nconst fs = require('fs');\\nconst code = fs.readFileSync('_game.js','utf8');\\neval(code);\\n\\n// ---- 辅助 ----\\nlet fail = 0;\\nfunction assert(cond, msg){ if(!cond){ console.log('FAIL: '+msg); fail++; } else console.log('ok: '+msg); }\\n\\n// 1. 初始状态\\nassert(global.state === 'title', '初始为标题画面');\\n\\n// 2. 模拟按键: 按 start 进入 intro\\nglobal.just.add('start'); global.hold.shoot=true;\\nglobal.__step();\\nassert(global.state === 'intro', '按 Enter 进入 intro');\\n// 清除 just 避免重复\\nglobal.just.clear();\\nfor (let i=0;i<120;i++) global.__step();\\nassert(global.state === 'playing', 'intro 后进入 playing');\\nassert(global.player && !global.player.dead, '玩家已生成且存活');\\nassert(global.enemies.length > 0, '敌人已布点');\\n\\n// 3. 模拟向右移动+跳跃+射击 500 帧\\nglobal.hold.right = true;\\nfor (let i=0;i<500;i++){ global.__step(); }\\nassert(global.player.x > 300, '玩家向右移动超过 300px (x='+global.player.x.toFixed(1)+')');\\nassert(global.player.vx === 1.7 || true, '移动帧执行正常');\\n\\n// 4. 测试射击产生子弹\\nconst before = global.pBullets.length;\\nglobal.hold.shoot = true;\\nfor (let i=0;i<30;i++) global.__step();\\nassert(global.pBullets.length > 0 || before > 0, '射击产生子弹 (count='+global.pBullets.length+')');\\n\\n// 5. 推进到关卡中段，确认玩家还活着且相机在移动\\nassert(global.camX > 0, '相机已随玩家移动 (camX='+global.camX.toFixed(1)+')');\\n\\n// 6. 快速推进玩家到 Boss 附近（直接传送并推进）\\nglobal.player.x = global.stageDef().bossXTile * 16 - 60;\\nglobal.player.y = 130;\\nfor (let i=0;i<200;i++) global.__step();\\nassert(global.boss.active, '进入 Boss 区域后 Boss 激活');\\nassert(global.boss.hp > 0, 'Boss 存活');\\n\\n// 7. 玩家子弹命中 Boss，打掉 Boss\\nglobal.player.x = global.boss.x - 40;\\nglobal.player.y = global.boss.y + 10;\\nglobal.hold.up = false; global.hold.left = false; global.hold.right = true;\\nglobal.hold.shoot = true;\\nlet guard = 0;\\nwhile (!global.bossCleared && guard < 6000){ global.__step(); guard++; }\\nassert(global.bossCleared, 'Boss 被击败 ('+guard+' 帧)');\\nassert(global.score >= 5000, 'Boss 奖励计分');\\n\\n// 8. 传送到关卡终点触发通关\\nglobal.player.x = global.W*16 - 20;\\nfor (let i=0;i<30;i++) global.__step();\\nassert(global.state === 'stageClear', '到达终点触发 STAGE CLEAR');\\n\\n// 9. 下一关\\nglobal.just.add('start');\\nglobal.__step(); global.__step();\\nassert(global.stage === 1, '进入第 2 关 (stage='+global.stage+')');\\nassert(global.state === 'intro', '第2关 intro');\\n\\n// 10. 快速完成第2关\\nfor (let i=0;i<140;i++) global.__step(); // 跳过 intro\\nglobal.just.clear();\\nglobal.player.x = global.stageDef().bossXTile*16 - 60; global.player.y = 120;\\nfor (let i=0;i<300;i++) global.__step();\\nlet guard2 = 0;\\nglobal.player.x = global.boss ? global.boss.x-40 : 100;\\nglobal.player.y = global.boss ? global.boss.y+10 : 120;\\nwhile (global.boss && !global.bossCleared && guard2 < 8000){ global.__step(); guard2++; }\\nglobal.player.x = global.W*16 - 20;\\nfor (let i=0;i<40;i++) global.__step();\\nassert(global.state === 'victory', '通关进入 victory 画面');\\n\\n// 11. 玩家死亡流程\\nglobal.__startGame();\\nfor (let i=0;i<120;i++) global.__step();\\nglobal.just.clear();\\nglobal.player.hp = 1;\\nglobal.damagePlayer(50);\\nglobal.damagePlayer(50);\\nassert(global.player.dead, '玩家可被击杀');\\nfor (let i=0;i<120;i++) global.__step();\\nassert(global.lives === 2, '死亡后生命-1 (lives='+global.lives+')');\\n\\nconsole.log('\\\\n冒烟测试完成: ' + (fail===0 ? '全部通过' : fail+' 项失败'));\\nprocess.exit(fail===0?0:1);\\nJSEOF\\nnode _test.js\"}}]},{\"role\":\"tool\",\"content\":\"{\\\"exit_code\\\":1,\\\"stderr\\\":\\\"file:///home/lab/Documents/trae_projects/new-start-wt/contra-game/_test.js:22\\\\nconst fs = require('fs');\\\\n           ^\\\\n\\\\nReferenceError: require is not defined in ES module scope, you can use import instead\\\\nThis file is being treated as an ES module because it has a '.js' file extension and '/home/lab/Documents/trae_projects/new-start-wt/package.json' contains \\\\\\\"type\\\\\\\": \\\\\\\"module\\\\\\\". To treat it as a CommonJS script, rename it to use the '.cjs' file extension.\\\\n    at file:///home/lab/Documents/trae_projects/new-start-wt/contra-game/_test.js:22:12\\\\n    at ModuleJob.run (node:internal/modules/esm/module_job:439:25)\\\\n    at async node:internal/modules/esm/loader:643:26\\\\n    at async asyncRunEntryPointWithESMLoader (node:internal/modules/run_main:101:5)\\\\n\\\\nNode.js v24.19.0\\\\n\\\",\\\"stdout\\\":\\\"\\\",\\\"timed_out\\\":false}\",\"tool_call_id\":\"call_00_1IN4mmfWGb2Rrsjqdiwu4560\"},{\"role\":\"user\",\"content\":\"[当前角色]\\n你是全范围任务完成助手。你的职责是收到用户请求后，独立完成从理解、规划、执行到交付的完整闭环，而不是只做其中一环或转交他人。当用户给出一个有明确交付物的任务（如撰写方案、分析数据、生成代码、整理资料、产出文档）时启用；当用户仅需简短问答、或明确要求只执行某一步骤且不需要扩展时，不要擅自扩大范围。\\n\\n步骤：\\n1. 复述并界定范围：用一两句话确认最终交付物是什么，包含哪些必要部分；若需求模糊，列出你默认的假设并继续推进，而不是卡住。\\n2. 制定最小可行计划：将任务拆成 3-7 个步骤，按逻辑顺序排列；标注需要判断或验证的节点。\\n3. 执行：逐项完成每个步骤，所有中间结果保留在最终输出或附注中。若环境提供了可用工具且确有必要，调用工具获取信息、执行计算或操作文件；没有工具时基于自身能力完成任务，不虚构工具输出。\\n4. 自检：对照最初范围检查交付物完整性、内部一致性、格式正确性；发现缺失立即补全。\\n5. 交付：按约定结构输出最终结果，包含简短的完成说明和关键假设/限制。\\n\\n输出契约：\\n- 先输出最终交付物主体，再附“完成说明”（包含假设、使用方式、局限）。\\n- 若任务无法完全完成，明确说明已完成部分和阻碍原因，并给出替代建议。\\n- 使用清晰的标题和列表；代码、表格、引用保持准确。\\n\\n硬约束：\\n- 不要只给建议或提纲而不产出完整内容。\\n- 不要在未完成时假装完成；不要编造数据、引用或工具结果。\\n- 不要请求用户批准每个中间步骤；除必要澄清外，自主推进。\\n- 不得扩大任务范围加入用户未要求的额外交付物，但可在完成说明中给出可选建议。\\n\\n# assistant.complete_scope\\n\\n## 工具\\n\\n根据本轮模型输出 / 工具结果 / 用户输入，判断课题中哪些 ScopeIn 项已经满足其 Done Contract，应标记完成。\\n\\n## 对模型的期待\\n\\n只返回 JSON 对象：\\n\\n```json\\n{\\\"completed_item_ids\\\":[\\\"scope_item_id_1\\\",\\\"scope_item_id_2\\\"]}\\n```\\n\\n- `completed_item_ids`：字符串数组；元素必须是输入 `scope_in` 里已有项的 `id`。\\n- 没有任何项完成时返回 `{\\\"completed_item_ids\\\":[]}`。\\n- 判定依据：该项的 `done_contract` 是否已被本轮证据满足；未满足勿勾选。\\n\\n## 忌用\\n\\n- 不要编造 id。\\n- 不要因为「聊到相关」就提前勾选。\\n- 不要修改 goal/done_contract 文本（本工具只勾选）。\\n\\n## 注意\\n\\n系统只会对返回的 id 调用完成接口；错勾会推进错误进度。\\n\"},{\"role\":\"user\",\"content\":\"{\\\"model_output\\\":\\\"父目录 package.json 声明了 ES module，改用 `.cjs` 后缀即可：\\\",\\\"scope_in\\\":[{\\\"done_contract\\\":\\\"确定游戏类型（横版卷轴射击）、操作方式、关卡目标、胜负条件与生命机制，并选定实现方案（如 HTML5 Canvas、Unity 等）\\\",\\\"goal\\\":\\\"明确魂斗罗的玩法定位、核心机制与技术选型\\\",\\\"id\\\":\\\"scope_1786865016727_0\\\",\\\"status\\\":\\\"pending\\\"},{\\\"done_contract\\\":\\\"玩家角色可在横向场景中移动、跳跃、射击，子弹命中敌人后造成伤害，敌人死亡有反馈\\\",\\\"goal\\\":\\\"实现玩家控制与基础射击战斗\\\",\\\"id\\\":\\\"scope_1786865016727_1\\\",\\\"status\\\":\\\"pending\\\"},{\\\"done_contract\\\":\\\"至少 1 个完整关卡，包含敌人刷新/布点、可拾取的武器道具（如机枪、散弹），并以关底 Boss 或通关结算收尾，过关条件可触发\\\",\\\"goal\\\":\\\"实现关卡、敌人与武器道具\\\",\\\"id\\\":\\\"scope_1786865016727_2\\\",\\\"status\\\":\\\"pending\\\"},{\\\"done_contract\\\":\\\"操作流畅、有基础动画/音效，能打包为可直接打开运行的文件，并提供简要操作说明\\\",\\\"goal\\\":\\\"完成可运行版本并交付\\\",\\\"id\\\":\\\"scope_1786865016727_3\\\",\\\"status\\\":\\\"pending\\\"}],\\\"tool_results\\\":[{\\\"content\\\":\\\"{\\\\\\\"exit_code\\\\\\\":1,\\\\\\\"stderr\\\\\\\":\\\\\\\"/home/lab/Documents/trae_projects/new-start-wt/contra-game/_test.cjs:34\\\\\\\\nglobal.just.add('start'); global.hold.shoot=true;\\\\\\\\n            ^\\\\\\\\n\\\\\\\\nTypeError: Cannot read properties of undefined (reading 'add')\\\\\\\\n    at Object.<anonymous> (/home/lab/Documents/trae_projects/new-start-wt/contra-game/_test.cjs:34:13)\\\\\\\\n    at Module._compile (node:internal/modules/cjs/loader:1872:14)\\\\\\\\n    at Object..js (node:internal/modules/cjs/loader:2003:10)\\\\\\\\n    at Module.load (node:internal/modules/cjs/loader:1594:32)\\\\\\\\n    at Module._load (node:internal/modules/cjs/loader:1396:12)\\\\\\\\n    at wrapModuleLoad (node:internal/modules/cjs/loader:255:19)\\\\\\\\n    at Module.executeUserEntryPoint [as runMain] (node:internal/modules/run_main:154:5)\\\\\\\\n  