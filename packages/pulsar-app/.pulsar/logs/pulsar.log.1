.phase === 'collect'){\\n      // 飞向阳光计数栏（左上角）\\n      s.x += (58 - s.x)*0.1; s.y += (30 - s.y)*0.1;\\n      if(Math.abs(s.x-58) < 4){ S.sun += s.value; s.dead = true; sfx.sun(); updateSunUI(); }\\n    }\\n  }\\n  S.suns = S.suns.filter(s=>!s.dead);\\n/* 阳光 */\\nfunction drawSun(ctx,s){\\n  const pulse = 1 + Math.sin(s.t/150)*0.08;\\n  ctx.save();\\n  ctx.translate(s.x,s.y); ctx.scale(pulse,pulse);\\n  const g = ctx.createRadialGradient(0,0,2,0,0,14);\\n  g.addColorStop(0,'#fffbe0'); g.addColorStop(0.55,'#ffd23f'); g.addColorStop(1,'#ff9800');\\n  ctx.fillStyle=g;\\n  ctx.beginPath(); ctx.arc(0,0,12,0,7); ctx.fill();\\n  ctx.strokeStyle='#ffb300'; ctx.lineWidth=3; ctx.lineCap='round';\\n  for(let i=0;i<8;i++){\\n    const a = s.t/200 + i*Math.PI/4;\\n    ctx.beginPath();\\n    ctx.moveTo(Math.cos(a)*13, Math.sin(a)*13);\\n    ctx.lineTo(Math.cos(a)*18, Math.sin(a)*18);\\n    ctx.stroke();\\n  }\\n  ctx.restore();\\n}\\n\\n/* 豌豆 */\\nfunction drawPea(ctx,p){\\n  ctx.save(); ctx.translate(p.x,p.y);\\n  const g = ctx.createRadialGradient(-1,-1,1,0,0,7);\\n  if(p.snow){\\n    g.addColorStop(0,'#e3f6ff'); g.addColorStop(1,'#4fc3f7');\\n  } else {\\n    g.addColorStop(0,'#d7f5b0'); g.addColorStop(1,'#66bb6a');\\n  }\\n  ctx.fillStyle=g;\\n  ctx.beginPath(); ctx.arc(0,0,6,0,7); ctx.fill();\\n  ctx.restore();\\n}\\n\\n/* 割草机 */\\nfunction drawMower(ctx,m){\\n  ctx.save();\\n  ctx.translate(m.x,m.y);\\n  ctx.fillStyle = m.active ? '#e53935' : '#c62828';\\n  ctx.beginPath(); ctx.rect(-14,-10,24,20); ctx.fill();\\n  ctx.fillStyle='#8e0000';\\n  ctx.beginPath(); ctx.arc(-16,2,7,0,7); ctx.fill();\\n  ctx.beginPath(); ctx.rect(-22,6,40,7); ctx.fill();\\n  ctx.fillStyle='#ffd54f';\\n  ctx.beginPath(); ctx.arc(0,-12,5,0,7); ctx.fill();\\n  ctx.restore();\\n}\\n\\n/* 特效 */\\nfunction drawEffects(ctx){\\n  for(const e of S.effects){\\n    const k = e.t/1000;\\n    if(e.type==='boom'){\\n      const r = 30 + k*130;\\n      ctx.strokeStyle = `rgba(255,${200-k*150},60,${1-k})`;\\n      