    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "dependency-cruiser": "^17.3.10",
    "jscpd": "^4.0.8",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "vitest": "^4.1.10"
  }
}
