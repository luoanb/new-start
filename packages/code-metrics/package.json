{
  "name": "@physalis/code-metrics",
  "version": "1.0.0",
  "private": true,
  "description": "Repository facts collector for objective code metrics.",
  "license": "ISC",
  "type": "module",
  "bin": {
    "code-metrics": "./src/cli.ts"
  },
  "scripts": {
    "baseline": "node --experimental-strip-types ./src/cli.ts baseline",
    "evidence": "node --experimental-strip-types ./src/cli.ts evidence",
