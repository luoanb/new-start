{
  "schemaVersion": "1.0",
  "documentStatus": "active",
  "id": "QLT-008",
  "name": "重复代码率",
  "upperBasis": ["指标治理规则", "代码交付规则"],
  "purpose": "限制大规模复制代码导致的同步修改和缺陷扩散风险",
  "risk": "重复实现会使同一逻辑产生多个变化点并逐渐漂移",
  "applicability": {
    "assetType": "source-code",
    "conditions": ["目标项目存在足够源码供令牌级重复检测"]
  },
  "measurement": {
    "unit": "percent",
    "direction": "max",
    "calculation": "被判定属于重复块的源码行数除以纳入检测的源码总行数再乘以 100",
    "dataRequirements": ["源码范围", "排除范围", "统一最小令牌和最小重复行参数"],
    "parameters": {
      "minimumTokens": 50,
      "minimumLines": 5
    }
  },
  "defaultPolicy": {
    "operator": "lte",
    "threshold": 5,
    "severity": "block"
  },
  "overridePolicy": {
    "threshold": true,
    "scope": true,
    "requiredFields": ["reason", "approvedBy", "scope", "expiresWhen"]
  },
  "downstreamProducts": ["重复代码采集器", "检测结果", "交付处置"]
}
