{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-paradigm.local/schemas/contract-relations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["participants", "relations"],
  "properties": {
    "participants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contract", "role"],
        "properties": {
          "id": { "type": "string", "pattern": "^CTR-[A-Z][A-Z0-9]*-[0-9]{3}$" },
          "contract": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type", "required"],
        "properties": {
          "from": { "type": "string", "pattern": "^CTR-[A-Z][A-Z0-9]*-[0-9]{3}$" },
          "to": { "type": "string", "pattern": "^CTR-[A-Z][A-Z0-9]*-[0-9]{3}$" },
          "type": {
            "enum": ["synchronous-call", "asynchronous-event", "data-reference", "lifecycle"]
          },
          "required": { "type": "boolean" },
          "interaction": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
